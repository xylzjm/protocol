<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.3" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpc"/>
 <package name="Shared" stereotype="0x00">
  <attribute name="modbus_slave_qp_signal" type="typedef enum" visibility="0x04" properties="0x00">
   <documentation>/**
 * @brief The backend's six protocol signals, one consecutive block.
 *
 * The block starts at MODBUS_SLAVE_QP_SIG_BASE (a global build macro,
 * default Q_USER_SIG). MB_FRAME_RCVED_SIG / MB_FRAME_SENT_SIG /
 * MB_TX_TIMEOUT_SIG are posted by the backend's event port from interrupt
 * context; MB_START_SIG / MB_STOP_SIG / MB_CONFIG_SIG are posted by the
 * application. MB_SIG_NEXT is the first value after the block, where the
 * application's own signals continue.
 */</documentation>
   <code>{
    MB_FRAME_RCVED_SIG = MODBUS_SLAVE_QP_SIG_BASE, /**&lt; A frame completed; process it. */
    MB_FRAME_SENT_SIG,                             /**&lt; The response went out on the wire. */
    MB_TX_TIMEOUT_SIG,                             /**&lt; Transmission watchdog expired. */
    MB_START_SIG,                                  /**&lt; Enter service: apply pending config. */
    MB_STOP_SIG,                                   /**&lt; Leave service. */
    MB_CONFIG_SIG,                                 /**&lt; Apply the pending configuration. */

    /** First value after this block; the next block or the app starts here. */
    MB_SIG_NEXT
} modbus_slave_qp_signal_t;</code>
  </attribute>
  <class name="modbus_slave_qp" superclass="qpc::QHsm">
   <documentation>/**
 * @brief Backend instance, embedded in the application AO.
 *
 * The backend is a QHsm component, not an active object: the AO forwards
 * the six protocol signals into it with
 * QASM_DISPATCH(&amp;me-&gt;backend.super, e, 0u) in every state it can be in
 * while the slave is in service. The state chart's source of truth is
 * backend/qp/model.qm.
 *
 * See the file-level documentation at the top of modbus_slave_qp.h for
 * the usage example and the full API contract.
 */</documentation>
   <attribute name="slave" type="modbus_slave_t*" visibility="0x02" properties="0x00">
    <documentation>/**
 * @brief Core instance owned by the board module.
 *
 * Stored, not copied. NULL only when modbus_slave_qp_ctor() was called
 * with a NULL core -- every core entry point tolerates NULL, so that
 * misuse degrades to a no-op instead of a crash.
 */</documentation>
   </attribute>
   <attribute name="app" type="QActive*" visibility="0x02" properties="0x00">
    <documentation>/**
 * @brief This channel's AO, receives the events.
 *
 * The event port posts the three protocol signals here with directed
 * posting, never publish, so two channels cannot cross-talk.
 */</documentation>
   </attribute>
   <attribute name="last_error" type="uint8_t" visibility="0x02" properties="0x00">
    <documentation>/**
 * @brief Saturating count of TX timeouts; see tx_timeout_count().
 *
 * Written only by the SENDING state handler (AO context); saturates at
 * 255 instead of wrapping.
 */</documentation>
   </attribute>
   <operation name="ctor" type="modbus_slave_status_t" visibility="0x00" properties="0x00">
    <documentation>/**
 * @brief Construct the backend and attach it to the core's event port.
 *
 * Must run before modbus_slave_start() (typically right after the board
 * has constructed the core). @p slave and @p app must not be NULL; both
 * are stored, not copied.
 *
 * @return MODBUS_SLAVE_OK, or MODBUS_SLAVE_ERR_ARG when an argument is
 * NULL, or the core's refusal (MODBUS_SLAVE_ERR_STATE) when the core has
 * already been started and the event port cannot be attached. On error
 * the caller owns the failure: do not call modbus_slave_qp_init() on a
 * backend that failed to construct.
 */</documentation>
    <parameter name="slave" type="modbus_slave_t*"/>
    <parameter name="app" type="QActive*"/>
    <code>modbus_slave_event_port_t event_port;

QHsm_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;modbus_slave_qp_initial));
me-&gt;slave      = slave;
me-&gt;app        = app;
me-&gt;last_error = 0U;

if ( slave == NULL || app == NULL ) {
    return MODBUS_SLAVE_ERR_ARG;
}

event_port.ctx               = me;
event_port.on_frame_received = frame_received;
event_port.on_frame_sent     = frame_sent;
event_port.on_tx_timeout     = tx_timeout;

/* The core was already started: it could never report a frame to
 * this backend. Propagate the refusal, so a caller that checks the
 * result cannot end up with a half-wired channel. */
return modbus_slave_set_event_port(slave, &amp;event_port);</code>
   </operation>
   <operation name="init" type="void" visibility="0x00" properties="0x00">
    <documentation>/**
 * @brief Run the initial transition (QASM_INIT).
 *
 * Call it once, after QACTIVE_START() (or from the AO's own initial
 * transition): that is when QP has given the AO its priority and event
 * queue, so an ISR-posted protocol event always has a valid target.
 * Calling it earlier would open the bus before posts to the AO have a
 * valid target.
 *
 * Enters the idle state, whose entry applies the pending configuration
 * and starts the core, so the slave is in service right after this call.
 */</documentation>
    <code>QASM_INIT(Q_ASM_UPCAST(me), NULL, 0);</code>
   </operation>
   <operation name="tx_timeout_count" type="uint8_t" visibility="0x00" properties="0x00">
    <documentation>/**
 * @brief Number of TX watchdog expiries since construction, saturating
 * at 255.
 *
 * Diagnostic only: a non-zero count means a response did not drain in
 * time (for example a baudrate mismatch or a stuck DE line).
 *
 * @return The saturating count.
 */</documentation>
    <code>return me-&gt;last_error;</code>
   </operation>
   <statechart properties="0x00">
    <documentation>Unconditional: land in IDLE, whose entry applies the pending
configuration and starts the core — the slave is in service as soon as
init() runs.</documentation>
    <initial target="../2">
     <initial_glyph conn="55,9,4,0,11">
      <action box="0,4,10,2"/>
     </initial_glyph>
    </initial>
    <state name="stopped">
     <documentation>/**
 * @brief Core stopped; entry calls modbus_slave_stop().
 *
 * MB_START restarts via the idle entry (which applies the pending
 * configuration). MB_CONFIG is discarded here -- the pending address
 * lives in the core and is applied at the next idle entry.
 */</documentation>
     <entry>modbus_slave_stop(me-&gt;slave);</entry>
     <tran trig="MB_START" target="../../2">
      <tran_glyph conn="29,30,1,3,14">
       <action box="2,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="13,20,16,16">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="idle">
     <documentation>/**
 * @brief In service.
 *
 * The entry applies the pending configuration and starts the core
 * (idempotent, ensures RX on). Handles the frame transaction
 * (receive -&gt; execute -&gt; send), runtime reconfiguration (MB_CONFIG) and
 * stop; stale completion events from an already finished transmission
 * are discarded.
 */</documentation>
     <entry>modbus_slave_apply_config(me-&gt;slave);
(void)modbus_slave_start(me-&gt;slave); /* idempotent, ensures RX on */</entry>
     <tran trig="MB_FRAME_RCVED">
      <action>modbus_slave_rx_status_t status;

status = modbus_slave_receive(me-&gt;slave);</action>
      <choice>
       <guard brief="RX_UNICAST">status == MODBUS_SLAVE_RX_UNICAST</guard>
       <action>modbus_slave_execute(me-&gt;slave);</action>
       <choice target="../../../../3">
        <guard brief="send_ok">modbus_slave_send(me-&gt;slave) == MODBUS_SLAVE_OK</guard>
        <choice_glyph conn="78,28,5,3,26">
         <action box="1,-2,10,2"/>
        </choice_glyph>
       </choice>
       <choice>
        <guard>else</guard>
        <action>/* send() refused: the core released the reception
 * window itself; keep waiting for the next request. */</action>
        <choice_glyph conn="78,28,4,-1,7,6">
         <action box="0,5,6,2"/>
        </choice_glyph>
       </choice>
       <choice_glyph conn="60,28,5,-1,18">
        <action box="1,-2,12,2"/>
       </choice_glyph>
      </choice>
      <choice>
       <guard brief="RX_BROADCAST">status == MODBUS_SLAVE_RX_BROADCAST</guard>
       <action>modbus_slave_execute(me-&gt;slave);</action>
       <choice_glyph conn="60,28,4,-1,7,15">
        <action box="0,5,15,2"/>
       </choice_glyph>
      </choice>
      <choice>
       <guard brief="RX_IGNORE">else</guard>
       <choice_glyph conn="60,28,4,-1,13,15">
        <action box="0,11,12,2"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="43,28,3,-1,17">
       <action box="0,-2,16,2"/>
      </tran_glyph>
     </tran>
     <tran trig="MB_CONFIG">
      <action>modbus_slave_apply_config(me-&gt;slave);</action>
      <tran_glyph conn="43,45,3,-1,11">
       <action box="0,-2,11,2"/>
      </tran_glyph>
     </tran>
     <tran trig="MB_STOP" target="../../1">
      <tran_glyph conn="54,50,2,2,11,-29,-25">
       <action box="-19,9,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="43,20,45,30">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state name="sending">
     <documentation>/**
 * @brief Response on the wire.
 *
 * MB_FRAME_SENT returns to idle; MB_TX_TIMEOUT aborts the transmission
 * (abort_tx), counts the incident in last_error and returns to idle;
 * MB_STOP stops everything via the stopped entry; MB_CONFIG is discarded
 * and applied at the next idle entry.
 */</documentation>
     <tran trig="MB_FRAME_SENT" target="../../2">
      <tran_glyph conn="107,36,2,1,5,-19">
       <action box="-16,3,15,2"/>
      </tran_glyph>
     </tran>
     <tran trig="MB_TX_TIMEOUT" target="../../2">
      <action>modbus_slave_abort_tx(me-&gt;slave);
if ( me-&gt;last_error &lt; 0xFFU ) {
    me-&gt;last_error++;
}</action>
      <tran_glyph conn="112,36,2,1,12,-24">
       <action box="-19,10,15,2"/>
      </tran_glyph>
     </tran>
     <tran trig="MB_STOP" target="../../1">
      <tran_glyph conn="117,36,2,2,31,-100,-31">
       <action box="-60,29,9,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="104,20,16,16"/>
    </state>
    <state_diagram size="133,77"/>
   </statechart>
  </class>
 </package>
 <directory name=".">
  <file name="modbus_slave_qp.h" properties="external"/>
  <file name="modbus_slave_qp.c" properties="external"/>
 </directory>
</model>
